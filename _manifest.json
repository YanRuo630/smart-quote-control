{
  "manifest_version": 2,
  "id": "smart-quote-control",
  "version": "1.0.0",
  "name": "智能引用回复控制",
  "description": "根据聊天环境和消息密度智能控制引用回复行为：私聊默认不引用，群聊根据消息量动态判断是否需要引用。",
  "author": {
    "name": "MaiBot Plugin Developer",
    "url": "https://github.com"
  },
  "license": "MIT",
  "urls": {
    "repository": "https://github.com",
    "homepage": "https://github.com",
    "documentation": "https://github.com",
    "issues": "https://github.com"
  },
  "host_application": {
    "min_version": "1.0.0",
    "max_version": "1.99.99"
  },
  "sdk": {
    "min_version": "1.0.0",
    "max_version": "2.99.99"
  },
  "dependencies": [],
  "plugin_type": "tool",
  "display": {
    "icon": {
      "type": "lucide",
      "value": "quote"
    }
  },
  "capabilities": ["send_message"],
  "i18n": {
    "default_locale": "zh-CN",
    "locales_path": "i18n",
    "supported_locales": ["zh-CN"]
  }
}
